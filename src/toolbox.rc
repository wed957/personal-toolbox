// Resources for the unified Toolbox launcher.
// Compiled with: windres --codepage=65001 toolbox.rc -O coff -o toolbox-res.o

1 ICON "toolbox.ico"

1 VERSIONINFO
FILEVERSION     1,1,0,0
PRODUCTVERSION  1,1,0,0
FILEOS          0x40004L   // VOS_NT_WINDOWS32
FILETYPE        0x1L       // VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404b0"   // zh-CN, Unicode
    BEGIN
      VALUE "CompanyName",      "wed957"
      VALUE "FileDescription",  "自用工具箱统一入口"
      VALUE "FileVersion",      "1.1.0"
      VALUE "InternalName",     "Toolbox"
      VALUE "OriginalFilename", "Toolbox.exe"
      VALUE "ProductName",      "Personal Toolbox"
      VALUE "ProductVersion",   "1.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0804, 1200
  END
END
